#!/bin/sh
# FSPIRAT: CGI для страницы fspirat.online/router/
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
SHUNT=9DxG2j8l
GROUP="nosok|fspirat"     # подписка и свои серверы
DIR=/tmp/fspirat
mkdir -p $DIR
TOKEN=$(cat /etc/fspirat.token 2>/dev/null)
REQ_TOKEN=${HTTP_COOKIE#*fspirat_token=}; REQ_TOKEN=${REQ_TOKEN%%;*}

reply() { printf "Status: %s\nContent-Type: application/json\nCache-Control: no-store\n\n%s\n" "$1" "$2"; exit 0; }
jesc() { tr -d '\000-\011\013-\037' | sed 's/\\/\\\\/g;s/"/\\"/g'; }    # без управляющих символов (кроме \n): имена из DHCP задаёт само устройство
bg() { ( setsid sh -c "$1" </dev/null >/dev/null 2>&1 & ); }

[ -n "$TOKEN" ] && [ "$REQ_TOKEN" = "$TOKEN" ] || reply "403 Forbidden" '{"error":"forbidden"}'

# Параметр запроса по точному имени (не «pcid=» вместо «id=»); значения дальше проверяются по своему формату
param() { echo "&$QUERY_STRING" | sed -n "s/^.*&$1=\([^&]*\).*$/\1/p" | head -1; }
# Раскодировать %XX (имена сервисов: скобки, русские буквы) — дальше сравнивается только с уже известными именами
urldec() { lua - "$1" <<'L'
io.write((arg[1]:gsub("+", " "):gsub("%%(%x%x)", function(h) return string.char(tonumber(h, 16)) end)))
L
}
action=$(param action | grep -E '^[a-z]{1,20}$')
id=$(param id | grep -E '^[A-Za-z0-9]{1,32}$')
mac=$(param mac | sed 's/%3[Aa]/:/g' | tr A-F a-f | grep -E '^([0-9a-f]{2}:){5}[0-9a-f]{2}$')

# Чтение — GET; всё, что меняет состояние или запускает работу, — только POST (nginx пускает POST только с CSRF-токеном).
case "$action" in
  status|net|pingone|mydirect|zapret|tgws) ;;
  *) [ "$REQUEST_METHOD" = POST ] || reply "405 Method Not Allowed" '{"error":"method"}' ;;
esac

cpu_sample() { awk '/^cpu /{t=0; for(i=2;i<=NF;i++) t+=$i; print t, $5+$6}' /proc/stat; }
wan_dev() { d=$(ifstatus wan 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null); echo "${d:-wan}"; }
net_sample() { sed 's/:/ /' /proc/net/dev | awk -v d="$1" '$1==d{print $2, $10}'; }

net_json() { # $1 dev, $2 r1, $3 x1, $4 r2, $5 x2
  echo "{\"dev\":\"$1\",\"rx\":$((($4-$2)*8)),\"tx\":$((($5-$3)*8)),\"rx_total\":$4,\"tx_total\":$5}"
}

net_only() {
  dev=$(wan_dev)
  set -- $(net_sample $dev); r1=${1:-0}; x1=${2:-0}
  sleep 1
  set -- $(net_sample $dev); r2=${1:-0}; x2=${2:-0}
  net_json "$dev" $r1 $x1 $r2 $x2
}

# Wi-Fi клиенты: "mac диапазон сигнал_dBm скорость_Мбит/с" (скорость — от роутера к устройству, TX)
wifi_clients() {
  for i in $(iwinfo 2>/dev/null | awk '/ESSID/{print $1}'); do
    case "$(iwinfo $i info 2>/dev/null)" in *"(5."[0-9]*" GHz)"*) b=5g ;; *"(6."[0-9]*" GHz)"*) b=6g ;; *) b=2g ;; esac
    iwinfo $i assoclist 2>/dev/null | awk -v b=$b '
      /^[0-9A-Fa-f][0-9A-Fa-f]:/{ if(m) print m, b, s, r; m=tolower($1); s=$2; r=0; next }
      /^[ \t]*TX:/{ r=int($2) }
      END{ if(m) print m, b, s, r }'
  done
}

devices_json() {
  printf '['
  first=1
  wifi_clients > $DIR/wifi.txt
  /usr/bin/fspirat-fw counters > $DIR/traf.txt 2>/dev/null     # «ip up dn» — байты с момента создания таблицы
  [ -f /tmp/dhcp.leases ] && while read -r exp mac ip name cid; do
    flags=$(awk -v ip="$ip" '$1==ip{print $3}' /proc/net/arp)
    [ "$flags" = "0x2" ] && on=true || on=false
    [ "$name" = "*" ] && name=""
    n=$(echo "$name" | jesc)
    set -- $(awk -v m="$mac" '$1==m{print $2, $3, $4; exit}' $DIR/wifi.txt)
    if [ -n "$1" ]; then w=",\"band\":\"$1\",\"signal\":${2:-0},\"rate\":${3:-0}"; on=true
    elif [ $on = true ]; then w=',"band":"wired"'
    else w=''; fi
    set -- $(awk -v ip="$ip" '$1==ip{print $2, $3; exit}' $DIR/traf.txt)
    t=",\"up\":${1:-0},\"dn\":${2:-0}"
    grep -qx "$mac" /etc/fspirat/blocked 2>/dev/null && t="$t,\"blocked\":true"
    grep -qx "$mac" /tmp/fspirat/sched_blocked 2>/dev/null && t="$t,\"sblocked\":true"
    [ -n "$(uci -q get passwall2.fsp_$(echo $mac | tr -d :))" ] && t="$t,\"direct\":true"
    sc=$(awk -v m="$mac" '$1==m{printf "%s-%s", $2, $3; exit}' /etc/fspirat/schedule 2>/dev/null)
    [ -n "$sc" ] && t="$t,\"sched\":\"$sc\""
    [ $first -eq 1 ] || printf ','
    first=0
    printf '{"name":"%s","ip":"%s","mac":"%s","online":%s%s%s}' "$n" "$ip" "$mac" "$on" "$w" "$t"
  done < /tmp/dhcp.leases
  printf ']'
}

sys_json() {
  dev=$(wan_dev)
  set -- $(cpu_sample); t1=$1; i1=$2
  set -- $(net_sample $dev); r1=${1:-0}; x1=${2:-0}
  sleep 1
  set -- $(cpu_sample); t2=$1; i2=$2
  set -- $(net_sample $dev); r2=${1:-0}; x2=${2:-0}
  dt=$((t2 - t1)); [ $dt -gt 0 ] && cpu=$(( 100 * (dt - (i2 - i1)) / dt )) || cpu=0
  cores=$(grep -c ^processor /proc/cpuinfo)
  load=$(cut -d' ' -f1-3 /proc/loadavg)
  mt=$(awk '/^MemTotal/{print $2}' /proc/meminfo)
  ma=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)
  set -- $(df -k /overlay 2>/dev/null | awk 'NR==2{print $2, $3}'); dtot=${1:-0}; dused=${2:-0}
  set -- $(df -k /tmp | awk 'NR==2{print $2, $3}'); ttot=${1:-0}; tused=${2:-0}
  t=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
  [ -n "$t" ] && temp=$((t / 1000)) || temp=null
  up=$(cut -d. -f1 /proc/uptime)
  model=$(cat /tmp/sysinfo/model 2>/dev/null | jesc)
  fw=$(. /etc/openwrt_release; echo "$DISTRIB_DESCRIPTION" | jesc)
  echo "{\"cpu\":$cpu,\"cores\":$cores,\"load\":\"$load\",\"mem_total\":$mt,\"mem_avail\":$ma,\"disk_total\":$dtot,\"disk_used\":$dused,\"tmp_total\":$ttot,\"tmp_used\":$tused,\"temp\":$temp,\"uptime\":$up,\"model\":\"$model\",\"fw\":\"$fw\",\"net\":$(net_json "$dev" $r1 $x1 $r2 $x2)}"
}

SOCKS=127.0.0.1:1070
CF=https://speed.cloudflare.com
RU=http://speedtest.selectel.ru                  # «напрямую» качаем из России: Cloudflare в РФ замедляют
EU=https://fsn1-speed.hetzner.com                # «через VPN» — из Германии (Cloudflare на частые замеры отвечает 429)
STREAMS=4
SECS=10

cs() { awk '{printf "%d", $1*100}' /proc/uptime; }    # сотые доли секунды (date +%N нет)

# STREAMS потоков одновременно; $1 — команда одного потока, печатает число байт. Результат — бит/с.
par_bits() {
  rm -f $DIR/st.*
  t1=$(cs)
  i=0; while [ $i -lt $STREAMS ]; do sh -c "$1" > $DIR/st.$i 2>/dev/null & i=$((i+1)); done
  wait
  t2=$(cs)
  cat $DIR/st.* 2>/dev/null | awk -v t=$((t2 - t1)) '{b+=$1} END{ if(t>0) printf "%d", b*8*100/t; else print 0 }'
  rm -f $DIR/st.*
}

speed_run() { # $1 = vpn | direct
  if [ "$1" = vpn ]; then P="-x socks5h://$SOCKS"; F="$EU/1GB.bin"; srv="Hetzner (Германия)"
  else P=""; F="$RU/1GB"; srv="Selectel (Россия)"; fi
  trace=$(curl -s -m 8 $P "$CF/cdn-cgi/trace")
  ip=$(echo "$trace" | sed -n 's/^ip=//p')
  cc=$(echo "$trace" | sed -n 's/^loc=//p')
  # задержка: время до первого байта, лучшее из трёх
  lat=$(for k in 1 2 3; do curl -s -m 5 $P -r 0-0 -o /dev/null -w '%{time_starttransfer}\n' "$F"; done | sort -n | head -1)
  # загрузка: каждый поток качает большой файл, curl обрывает через SECS секунд и сообщает, сколько успел
  down=$(par_bits "curl -s -m $SECS $P -o /dev/null -w '%{size_download}\n' $F")
  # отдача (только Cloudflare: Selectel и Hetzner приём не умеют): каждый поток шлёт по 8 МБ, пока не выйдет время
  head -c 8000000 /dev/zero > $DIR/up.bin
  up=$(par_bits "end=\$((\$(awk '{printf \"%d\", \$1*100}' /proc/uptime) + $SECS * 100))
    while [ \$(awk '{printf \"%d\", \$1*100}' /proc/uptime) -lt \$end ]; do
      curl -s -m 5 $P -o /dev/null -w '%{http_code} %{size_upload}\n' --data-binary @$DIR/up.bin $CF/__up || { echo \$? >> $DIR/uperr; sleep 1; }
    done | awk '\$1==200{b+=\$2} \$1==429{print \"429\" > \"$DIR/limited\"} END{print b+0}'")
  rm -f $DIR/up.bin $DIR/uperr.last; [ -f $DIR/uperr ] && mv $DIR/uperr $DIR/uperr.last   # коды ошибок curl — для разбора
  [ -f $DIR/limited ] && limited=true || limited=false; rm -f $DIR/limited
  awk -v d="${down:-0}" -v u="${up:-0}" -v l="${lat:-0}" -v ip="$ip" -v cc="$cc" -v via="$1" -v srv="$srv" -v n=$STREAMS -v lim=$limited -v ts="$(date +%s)" \
    'BEGIN{printf "{\"via\":\"%s\",\"ts\":%s,\"down\":%d,\"up\":%d,\"latency\":%d,\"ip\":\"%s\",\"country\":\"%s\",\"server\":\"%s\",\"streams\":%d,\"up_limited\":%s}", via, ts, d, u, l*1000, ip, cc, srv, n, lim}'
}

status_json() {
  cur=$(uci -q get passwall2.$SHUNT.default_node)
  glob=$(uci -q get passwall2.@global[0].node)
  pidof xray >/dev/null && run=true || run=false
  [ "$glob" = "$SHUNT" ] && split=true || split=false
  ping=$(cat $DIR/ping.json 2>/dev/null); [ -n "$ping" ] || ping=null
  log=$(tail -n 8 $DIR/switch.log 2>/dev/null | jesc | sed 's/.*/"&"/' | tr '\n' ',' | sed 's/,$//')
  sv=$(cat $DIR/speed_vpn.json 2>/dev/null); [ -n "$sv" ] || sv=null
  sd=$(cat $DIR/speed_direct.json 2>/dev/null); [ -n "$sd" ] || sd=null
  tg=$(cat $DIR/targets.json 2>/dev/null); [ -n "$tg" ] || tg=null
  tl=$(cat /etc/fspirat/targets 2>/dev/null || cat $DIR/targets.default 2>/dev/null)
  tl=$(echo "$tl" | jesc | awk 'NF{printf "%s\"%s\"", (n++?",":""), $0}')
  svc=$(for f in $DIR/svc/*.json; do [ -f "$f" ] && printf '"%s":%s,' "$(basename "$f" .json)" "$(cat "$f")"; done | sed 's/,$//')
  [ -f $DIR/svc/lock ] && kill -0 "$(cat $DIR/svc/lock)" 2>/dev/null && svcrun=true || svcrun=false
  hist=$(awk '{printf "%s[%s,%s]", (NR>1?",":""), $1, $2}' $DIR/history 2>/dev/null)
  sub=$(cat $DIR/sub.json 2>/dev/null); [ -n "$sub" ] || sub=null
  sdl=$(cut -d'|' -f1 /etc/fspirat/svc_direct 2>/dev/null | jesc | awk 'NF{printf "%s\"%s\"", (n++?",":""), $0}')   # не sd: sd — тест скорости напрямую
  echo "{\"running\":$run,\"split_active\":$split,\"current\":\"$cur\",\"ping\":$ping,\"log\":[$log],\"history\":[$hist],\"targets\":$tg,\"sub\":$sub,\"svc_direct\":[$sdl],\"target_list\":[$tl],\"svc\":{$svc},\"svc_running\":$svcrun,\"speed\":{\"vpn\":$sv,\"direct\":$sd},\"devices\":$(devices_json),\"sys\":$(sys_json)}"
}

case "$action" in
  status) reply "200 OK" "$(status_json)" ;;
  net) reply "200 OK" "$(net_only)" ;;
  ping) /usr/bin/fspirat-ping all >/dev/null 2>&1; reply "200 OK" "$(status_json)" ;;
  targets) reply "200 OK" "$(/usr/bin/fspirat-targets 2>/dev/null)" ;;
  pingone)   # TCP-пинг одного сервера (лучший из трёх), заодно обновляет его в ping.json
    [ -n "$id" ] && uci -q get passwall2.$id.group | grep -qxE "$GROUP" || reply "400 Bad Request" '{"error":"bad node"}'
    addr=$(uci -q get passwall2.$id.address); port=$(uci -q get passwall2.$id.port)
    best=0
    for k in 1 2 3; do
      ms=$(tcping -q -c 1 -i 1 -t 2 -p "$port" "$addr" 2>&1 | grep -o 'time=[0-9]*' | head -1 | cut -d= -f2)
      [ -n "$ms" ] && { [ $best -eq 0 ] || [ "$ms" -lt $best ]; } && best=$ms
    done
    [ -f $DIR/ping.json ] && sed -i "s/\(\"id\":\"$id\",\"name\":\"[^\"]*\",\"ms\":\)[0-9]*/\1$best/" $DIR/ping.json
    reply "200 OK" "{\"id\":\"$id\",\"ms\":$best,\"ts\":$(date +%s)}" ;;
  switch)       # id=direct — без VPN: всё, кроме правил Split, идёт напрямую (default_node=_direct)
    if [ "$id" = direct ]; then id=_direct
    else [ -n "$id" ] && uci -q get passwall2.$id.group | grep -qxE "$GROUP" || reply "400 Bad Request" '{"error":"bad node"}'; fi
    uci set passwall2.$SHUNT.default_node="$id"
    uci commit passwall2
    echo 0 > $DIR/fails
    echo "$(date '+%d.%m %H:%M') вручную -> $id" >> $DIR/switch.log
    bg "/etc/init.d/passwall2 restart"
    reply "200 OK" '{"ok":true}' ;;
  restart)
    echo "$(date '+%d.%m %H:%M') перезапуск VPN" >> $DIR/switch.log
    bg "/etc/init.d/passwall2 restart"
    reply "200 OK" '{"ok":true}' ;;
  update)
    [ -f /usr/share/passwall2/subscribe.lua ] || reply "500 Internal Server Error" '{"error":"subscribe.lua not found"}'
    echo "$(date '+%d.%m %H:%M') обновление подписки" >> $DIR/switch.log
    bg "lua /usr/share/passwall2/subscribe.lua start; sleep 5; /usr/bin/fspirat-ping"
    reply "200 OK" '{"ok":true}' ;;
  speedtest)
    via=$(param via)
    [ "$via" = vpn ] || [ "$via" = direct ] || reply "400 Bad Request" '{"error":"bad via"}'
    # один тест за раз: mkdir атомарен (два запроса в одну секунду не запустят два теста); зависший — через 3 минуты снимается
    L=$DIR/speed.lockd
    [ -d $L ] && [ $(( $(date +%s) - $(cat $L/ts 2>/dev/null || echo 0) )) -gt 180 ] && rm -rf $L
    mkdir $L 2>/dev/null || reply "409 Conflict" '{"error":"busy"}'
    date +%s > $L/ts
    res=$(speed_run $via)
    rm -rf $L
    echo "$res" > $DIR/speed_$via.json
    reply "200 OK" "$res" ;;
  block|unblock)   # выключить / включить интернет устройству (fspirat-fw)
    echo "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || reply "400 Bad Request" '{"error":"bad mac"}'
    /usr/bin/fspirat-fw $action "$mac" || reply "500 Internal Server Error" '{"error":"nft"}'
    echo "$(date '+%d.%m %H:%M') $([ $action = block ] && echo 'интернет выключен' || echo 'интернет включён'): $mac" >> $DIR/switch.log
    reply "200 OK" "{\"ok\":true,\"mac\":\"$mac\",\"blocked\":$([ $action = block ] && echo true || echo false)}" ;;
  direct)   # устройство мимо VPN (правило доступа PassWall без узла = напрямую); перезапуск PassWall ~5 с
    [ -n "$mac" ] || reply "400 Bad Request" '{"error":"bad mac"}'
    sid=fsp_$(echo "$mac" | tr -d :)
    if [ "$(param on)" = 1 ]; then
      uci set passwall2.$sid=acl_rule; uci set passwall2.$sid.enabled=1; uci set passwall2.$sid.remarks="FSPIRAT: мимо VPN"
      uci -q delete passwall2.$sid.sources; uci add_list passwall2.$sid.sources="$mac"
    else uci -q delete passwall2.$sid; fi
    [ -n "$(uci show passwall2 | grep '=acl_rule$')" ] && uci set passwall2.@global[0].acl_enable=1 || uci set passwall2.@global[0].acl_enable=0
    uci commit passwall2
    echo "$(date '+%d.%m %H:%M') $([ "$(param on)" = 1 ] && echo 'мимо VPN' || echo 'снова через VPN'): $mac" >> $DIR/switch.log
    bg "/etc/init.d/passwall2 restart"
    reply "200 OK" "{\"ok\":true,\"direct\":$([ "$(param on)" = 1 ] && echo true || echo false)}" ;;
  schedule)   # расписание интернета устройству: off/on — ЧЧММ; пустой off — убрать
    [ -n "$mac" ] || reply "400 Bad Request" '{"error":"bad mac"}'
    off=$(param off); on=$(param on); mkdir -p /etc/fspirat; touch /etc/fspirat/schedule
    grep -v "^$mac " /etc/fspirat/schedule > /etc/fspirat/schedule.tmp
    if [ -n "$off" ]; then
      for v in "$off" "$on"; do echo "$v" | grep -qE '^([01][0-9]|2[0-3])[0-5][0-9]$' || { rm -f /etc/fspirat/schedule.tmp; reply "400 Bad Request" '{"error":"time"}'; }; done
      [ "$off" != "$on" ] || { rm -f /etc/fspirat/schedule.tmp; reply "400 Bad Request" '{"error":"time"}'; }
      echo "$mac $off $on" >> /etc/fspirat/schedule.tmp
    fi
    mv /etc/fspirat/schedule.tmp /etc/fspirat/schedule
    /usr/bin/fspirat-fw schedule
    reply "200 OK" '{"ok":true}' ;;
  mydirect)   # список «напрямую» (MyDirect): домены; added — добавленные из панели
    rule=$(uci show passwall2 | grep "\.remarks='MyDirect'" | head -1 | cut -d. -f2)
    [ -n "$rule" ] || reply "500 Internal Server Error" '{"error":"no rule"}'
    dl=$(uci -q get passwall2.$rule.domain_list | tr -d '\r' | jesc | awk 'NF{printf "%s\"%s\"", (n++?",":""), $0}')
    ad=$(cat /etc/fspirat/mydirect_added 2>/dev/null | awk 'NF{printf "%s\"%s\"", (n++?",":""), $0}')
    reply "200 OK" "{\"domains\":[$dl],\"added\":[$ad]}" ;;
  diradd|dirdel)   # добавить / убрать домен в MyDirect (перезапуск PassWall ~5 с)
    d=$(param d | tr A-Z a-z)
    echo "$d" | grep -qE '^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]{0,61}[a-z0-9]$' && [ ${#d} -le 100 ] || reply "400 Bad Request" '{"error":"domain"}'
    rule=$(uci show passwall2 | grep "\.remarks='MyDirect'" | head -1 | cut -d. -f2)
    [ -n "$rule" ] || reply "500 Internal Server Error" '{"error":"no rule"}'
    cur=$(uci -q get passwall2.$rule.domain_list | tr -d '\r')
    if [ $action = diradd ]; then
      echo "$cur" | grep -qx "$d" && reply "200 OK" '{"ok":true,"same":true}'
      uci set passwall2.$rule.domain_list="$(printf '%s\n%s' "$d" "$cur")"
      echo "$d" >> /etc/fspirat/mydirect_added
    else
      echo "$cur" | grep -qx "$d" || reply "200 OK" '{"ok":true,"same":true}'
      uci set passwall2.$rule.domain_list="$(echo "$cur" | grep -vxF "$d")"
      grep -vxF "$d" /etc/fspirat/mydirect_added > /etc/fspirat/mydirect_added.tmp 2>/dev/null; mv /etc/fspirat/mydirect_added.tmp /etc/fspirat/mydirect_added
    fi
    uci commit passwall2
    echo "$(date '+%d.%m %H:%M') MyDirect $([ $action = diradd ] && echo '+' || echo '−') $d" >> $DIR/switch.log
    bg "/etc/init.d/passwall2 restart"
    reply "200 OK" '{"ok":true}' ;;
  svcdirect)   # сервис из списка — напрямую: сайт — его домен в MyDirect, Minecraft — IP сервера в MyDirect (игра идёт по IP)
    name=$(urldec "$(param name)")
    line=$(cat /etc/fspirat/targets 2>/dev/null || cat $DIR/targets.default) ; line=$(echo "$line" | awk -F'|' -v n="$name" '$2==n{print; exit}')
    [ -n "$line" ] || reply "400 Bad Request" '{"error":"no target"}'
    kind=${line%%|*}; addr=${line##*|}
    rule=$(uci show passwall2 | grep "\.remarks='MyDirect'" | head -1 | cut -d. -f2)
    [ -n "$rule" ] || reply "500 Internal Server Error" '{"error":"no rule"}'
    SD=/etc/fspirat/svc_direct; touch $SD
    old=$(awk -F'|' -v n="$name" '$1==n{print $3}' $SD)      # что добавляли раньше (домен или IP через пробел)
    dl=$(uci -q get passwall2.$rule.domain_list | tr -d '\r'); il=$(uci -q get passwall2.$rule.ip_list | tr -d '\r')
    for x in $old; do dl=$(echo "$dl" | grep -vxF "$x"); il=$(echo "$il" | grep -vxF "$x/32"); done
    awk -F'|' -v n="$name" '$1!=n' $SD > $SD.tmp
    if [ "$(param on)" = 1 ]; then
      if [ "$kind" = web ]; then
        h=$(echo "$addr" | sed 's#^[a-z]*://##; s#/.*##; s#^www\.##'); new=$h; dl=$(printf '%s\n%s' "$h" "$dl")
      else
        h=${addr%:*}; new=$(nslookup "$h" 2>/dev/null | awk '/^Name:/{n=1} n && /^Address/ && $NF !~ /:/ {print $NF}' | sort -u | tr '\n' ' ')
        [ -n "$new" ] || { rm -f $SD.tmp; reply "400 Bad Request" '{"error":"resolve"}'; }
        for x in $new; do il=$(printf '%s/32\n%s' "$x" "$il"); done
      fi
      echo "$name|$kind|$new" >> $SD.tmp
    fi
    mv $SD.tmp $SD
    uci set passwall2.$rule.domain_list="$(echo "$dl" | sed '/^$/d')"
    uci set passwall2.$rule.ip_list="$(echo "$il" | sed '/^$/d')"
    uci commit passwall2
    echo "$(date '+%d.%m %H:%M') $name: $([ "$(param on)" = 1 ] && echo 'напрямую' || echo 'через VPN')" >> $DIR/switch.log
    bg "/etc/init.d/passwall2 restart"
    reply "200 OK" '{"ok":true}' ;;
  settargets)   # свой список для пинга: list=вид~имя~адрес!вид~имя~адрес… (до 8 строк); пусто — список по умолчанию
    res=$(lua - "$QUERY_STRING" <<'L'
local q = ('&' .. arg[1]):match('&list=([^&]*)') or ''
if #q > 3000 then io.write('long'); os.exit(0) end
q = q:gsub('+', ' '):gsub('%%(%x%x)', function(h) return string.char(tonumber(h, 16)) end)
-- Адрес не должен вести внутрь: роутер, домашняя сеть, сам сервер панели (замер идёт с роутера — это SSRF).
-- Имена проверяются здесь, IP после DNS — ещё раз при каждом замере (fspirat-targets, защита от DNS rebinding).
local function inner(h)
  h = h:lower()
  if h == 'localhost' or h:match('%.localhost$') or h:match('%.local$') or h:match('%.lan$') or h:match('%.home%.arpa$')
     or h:match('%.internal$') or not h:find('%.') then return true end
  if h:match('^0x') or h:match('^[%d]+$') then return true end          -- 0x7f000001, 2130706433 — тот же 127.0.0.1
  local a, b, c, d = h:match('^(%d+)%.(%d+)%.(%d+)%.(%d+)$')
  if not a then return h:match('^[%d.]+$') ~= nil end                    -- 127.1 и прочие сокращения IP
  a, b = tonumber(a), tonumber(b)
  return a == 0 or a == 10 or a == 127 or a >= 224 or (a == 100 and b >= 64 and b <= 127) or (a == 169 and b == 254)
      or (a == 172 and b >= 16 and b <= 31) or (a == 192 and b == 168) or (a == 198 and (b == 18 or b == 19))
      or tonumber(c) > 255 or tonumber(d) > 255 or a > 255 or b > 255
end
local out, n = {}, 0
for e in (q .. '!'):gmatch('([^!]*)!') do
  if e ~= '' then
    local k, name, a = e:match('^(%a+)~([^~]+)~([^~]+)$')
    if not k then io.write('bad'); os.exit(0) end
    name = name:gsub('^%s+', ''):gsub('%s+$', '')
    -- имя: без служебных символов, до 40 байт (~20 русских букв)
    if #name < 1 or #name > 40 or name:find('[%c|~!"<>&]') or name:find('\\', 1, true) then io.write('name'); os.exit(0) end
    if k == 'web' then
      if not a:match('^https?://[%w%.%-]+[%w%-%./_%?=]*$') or #a > 200 then io.write('url'); os.exit(0) end
      if inner(a:match('^https?://([%w%.%-]+)')) then io.write('inner'); os.exit(0) end
    elseif k == 'mc' then
      local h, p = a:match('^([%w%.%-]+):?(%d*)$')
      if not h or #h > 100 or (p ~= '' and (tonumber(p) < 1 or tonumber(p) > 65535)) then io.write('host'); os.exit(0) end
      if inner(h) then io.write('inner'); os.exit(0) end
      a = h .. ':' .. (p ~= '' and p or '25565')
    else io.write('kind'); os.exit(0) end
    n = n + 1; if n > 8 then io.write('many'); os.exit(0) end
    out[#out + 1] = k .. '|' .. name .. '|' .. a
  end
end
os.execute('mkdir -p /etc/fspirat')
if #out == 0 then os.remove('/etc/fspirat/targets') else
  local f = io.open('/etc/fspirat/targets.new', 'w'); f:write(table.concat(out, '\n') .. '\n'); f:close()
  os.rename('/etc/fspirat/targets.new', '/etc/fspirat/targets')
end
io.write('ok')
L
)
    [ "$res" = ok ] || reply "400 Bad Request" "{\"error\":\"$res\"}"
    rm -f $DIR/svc/*.json
    bg "/usr/bin/fspirat-targets; /usr/bin/fspirat-svcping"
    reply "200 OK" "{\"ok\":true,\"list\":\"$(cat /etc/fspirat/targets 2>/dev/null | jesc | tr '\n' '\t')\"}" ;;
  reboot)
    bg "sleep 2; reboot"
    reply "200 OK" '{"ok":true}' ;;

  # «YouTube и Discord через zapret» (/usr/bin/fspirat-zapret). Из браузера приходят только on=0|1 и номер стратегии.
  zapret)       # состояние: выбранный режим, движок, правила nftables, маршрут PassWall, ошибки, последняя проверка
    [ -x /usr/bin/fspirat-zapret ] || reply "200 OK" '{"installed":false,"absent":true}'
    reply "200 OK" "$(/usr/bin/fspirat-zapret status)" ;;
  zapretset)    # включить / выключить (перезапуск PassWall ~5 с — фоном; результат видно в состоянии)
    on=$(param on | grep -E '^[01]$'); [ -n "$on" ] || reply "400 Bad Request" '{"error":"bad on"}'
    [ -x /usr/bin/fspirat-zapret ] || reply "503 Service Unavailable" '{"error":"not installed"}'
    [ -d /tmp/fspirat/zapret/lock ] && reply "409 Conflict" '{"error":"busy"}'
    bg "/usr/bin/fspirat-zapret $([ "$on" = 1 ] && echo on || echo off)"
    reply "200 OK" '{"ok":true}' ;;
  zapretstrat)  # стратегия обхода — только из фиксированного списка
    n=$(param n | grep -E '^[123]$'); [ -n "$n" ] || reply "400 Bad Request" '{"error":"bad strategy"}'
    [ -x /usr/bin/fspirat-zapret ] || reply "503 Service Unavailable" '{"error":"not installed"}'
    bg "/usr/bin/fspirat-zapret strategy $n"
    reply "200 OK" '{"ok":true}' ;;
  zapretcheck)  # проверка доступности YouTube/Discord через Xray (~10–40 с, фоном)
    [ -x /usr/bin/fspirat-zapret ] || reply "503 Service Unavailable" '{"error":"not installed"}'
    [ -f /tmp/fspirat/zapret/checking ] && reply "409 Conflict" '{"error":"busy"}'
    bg "mkdir -p /tmp/fspirat/zapret; touch /tmp/fspirat/zapret/checking; /usr/bin/fspirat-zapret check; rm -f /tmp/fspirat/zapret/checking"
    reply "200 OK" '{"ok":true}' ;;
  # Telegram через tg-ws-proxy (/usr/bin/fspirat-tgws): MTProto-прокси для устройств дома, переключатель в блоке zapret
  tgws)         # состояние: установлен, включён, процесс, порт
    [ -x /usr/bin/fspirat-tgws ] || reply "200 OK" '{"installed":false,"absent":true}'
    reply "200 OK" "$(/usr/bin/fspirat-tgws status)" ;;
  tgwsset)      # включить / выключить (только служба прокси; PassWall и firewall не трогает)
    on=$(param on | grep -E '^[01]$'); [ -n "$on" ] || reply "400 Bad Request" '{"error":"bad on"}'
    [ -x /usr/bin/fspirat-tgws ] || reply "503 Service Unavailable" '{"error":"not installed"}'
    bg "/usr/bin/fspirat-tgws $([ "$on" = 1 ] && echo on || echo off)"
    reply "200 OK" '{"ok":true}' ;;
  tgwslink)     # ссылка tg://proxy с секретом — только POST (не кэшируется и не попадает в историю)
    [ -x /usr/bin/fspirat-tgws ] || reply "503 Service Unavailable" '{"error":"not installed"}'
    reply "200 OK" "{\"link\":\"$(/usr/bin/fspirat-tgws link | jesc)\"}" ;;
  *) reply "400 Bad Request" '{"error":"unknown action"}' ;;
esac
