#!/bin/sh /etc/rc.common
# FSPIRAT: tg-ws-proxy — MTProto-прокси Telegram для устройств дома (<IP роутера>:1443, только LAN).
# Запускается, только если включён (/etc/fspirat/tgws: ENABLED=1). Управление — /usr/bin/fspirat-tgws.
# Перехват Telegram (таблица inet fspirat_tg) ставит/снимает fspirat-tgws (on/off и сторож ensure в cron).
START=99
STOP=10
USE_PROCD=1

start_service() {
	grep -qx 'ENABLED=1' /etc/fspirat/tgws 2>/dev/null || return 0
	[ -f /usr/share/fspirat-tgws/proxy/tg_ws_proxy.py ] || return 0
	secret=$(sed -n 's/^SECRET=//p' /etc/fspirat/tgws | grep -E '^[0-9a-f]{32}$')
	[ -n "$secret" ] || return 0
	ip=$(uci -q get network.lan.ipaddr); ip=${ip%%/*}
	procd_open_instance tgws
	# --pool-size 0: прямые адреса Telegram у провайдера закрыты — сразу через Cloudflare (CF-прокси проекта)
	# 1443 — обычный MTProto-прокси (ссылка в панели), 1444 — прозрачный режим (перехват nftables)
	procd_set_param command python3 -u -m fspirat_transparent --transparent-port 1444 \
		--host "${ip:-192.168.1.1}" --port 1443 --secret "$secret" --pool-size 0
	procd_set_param env PYTHONPATH=/usr/share/fspirat-tgws/lib:/usr/share/fspirat-tgws PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
	procd_set_param user nobody
	procd_set_param respawn 300 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	start "$@"
	( sleep 40; /usr/bin/fspirat-tgws ensure ) >/dev/null 2>&1 &
}

stop_service() {
	nft delete table inet fspirat_tg 2>/dev/null   # без прокси перехват не оставляем
	return 0
}
