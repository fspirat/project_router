#!/bin/sh /etc/rc.common
# FSPIRAT: движок zapret (nfqws) для режима «YouTube и Discord через zapret».
# Запускается, только если режим включён (/etc/fspirat/zapret: ENABLED=1). Таблицу nftables и маршрут
# PassWall ведёт /usr/bin/fspirat-zapret (on/off/ensure); procd перезапускает nfqws при падении,
# а если он не поднимается — сторож (cron, раз в минуту) возвращает YouTube и Discord в VPN.
START=99
STOP=10
USE_PROCD=1

start_service() {
	grep -qx 'ENABLED=1' /etc/fspirat/zapret 2>/dev/null || return 0
	[ -x /usr/share/fspirat-zapret/nfqws ] || return 0
	procd_open_instance nfqws
	# shellcheck disable=SC2046
	procd_set_param command /usr/share/fspirat-zapret/nfqws $(/usr/bin/fspirat-zapret args)
	procd_set_param respawn 300 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

boot() {
	start "$@"
	# после загрузки: сторож поднимет таблицу nftables и маршрут PassWall (или вернёт YouTube/Discord в VPN)
	( sleep 30; /usr/bin/fspirat-zapret ensure ) >/dev/null 2>&1 &
}

service_triggers() {
	# fw4 нашу таблицу не трогает; при изменении настроек firewall всё равно проверяем её (и cron раз в минуту)
	procd_add_reload_trigger firewall
}

reload_service() {
	/usr/bin/fspirat-zapret ensure >/dev/null 2>&1 &
}
