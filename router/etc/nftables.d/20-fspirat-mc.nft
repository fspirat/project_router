# /etc/nftables.d/20-fspirat-mc.nft — входит в таблицу inet fw4 (переживает перезагрузку и fw4 reload).
# Сервер Minecraft на MacBook (192.168.7.108): проброс WAN TCP 25565 делает uci-правило firewall «MC-MacBook».
# Здесь — пускать на него только адреса TCPShield (https://tcpshield.com/v4), остальным — drop.
# Список обновляет /usr/bin/fspirat-tcpshield (cron раз в сутки): меняет строку elements ниже и живой набор.
# Лимит по адресу не ставим: все игроки приходят с немногих адресов TCPShield.
set fspirat_mc_tcpshield {
	type ipv4_addr
	flags interval
	auto-merge
	elements = { 104.234.6.0/25, 198.178.119.0/24 }  # fspirat-tcpshield
}

chain fspirat_mc_allow {
	type filter hook forward priority filter - 1; policy accept;
	iifname "wan" ip daddr 192.168.7.108 tcp dport 25565 ip saddr @fspirat_mc_tcpshield counter accept comment "fspirat: MC via TCPShield"
	iifname "wan" ip daddr 192.168.7.108 tcp dport 25565 counter drop comment "fspirat: MC not TCPShield"
}
