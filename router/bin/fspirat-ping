#!/bin/sh
# FSPIRAT: TCP-пинг узлов, настоящая проверка текущего сервера через SOCKS
# и автопереключение «По умолчанию» в Split, если текущий перестал работать.

# Узлы: серверы всех подписок PassWall2 (группа = название подписки) и свои (группа fspirat, добавлены вручную)
GROUPS=$(/usr/bin/fspirat-subs groups 2>/dev/null | tr 'A-Z' 'a-z'); [ -n "$GROUPS" ] || GROUPS="fspirat"
# Узел Split (shunt) в PassWall2: SHUNT из /etc/fspirat/config, иначе выбранный в Basic Settings → Node, если это shunt, иначе первый shunt
[ -f /etc/fspirat/config ] && . /etc/fspirat/config
[ -n "$SHUNT" ] || { SHUNT=$(uci -q get passwall2.@global[0].node); [ "$(uci -q get passwall2.$SHUNT.protocol)" = _shunt ] || SHUNT=$(uci show passwall2 2>/dev/null | sed -n "s/^passwall2\.\([^.=]*\)\.protocol='_shunt'$/\1/p" | head -1); }
EXCLUDE=${EXCLUDE:-LTE|Россия|Обход}   # узлы с такими словами в имени не пингуются и не выбираются (можно задать в /etc/fspirat/config)
SOCKS="127.0.0.1:1070"
TEST_URL="http://www.gstatic.com/generate_204"
FAILS_TO_SWITCH=2
HIST_MAX=288            # 288 точек * 5 минут = 24 часа
DIR=/tmp/fspirat
mkdir -p $DIR/res

# не запускаться дважды одновременно
if [ -f $DIR/lock ] && kill -0 "$(cat $DIR/lock)" 2>/dev/null; then exit 0; fi
echo $$ > $DIR/lock
trap 'rm -f $DIR/lock' EXIT INT TERM
rm -f $DIR/res/*
/usr/bin/fspirat-fw 2>/dev/null       # таблица счётчиков и блокировок (после перезагрузки её нет)

ping_node() {
  ms=$(tcping -q -c 1 -i 1 -t 2 -p "$3" "$2" 2>&1 | grep -o 'time=[0-9]*' | head -1 | cut -d= -f2)
  echo "${ms:-0}" > $DIR/res/$1
}

CUR=$(uci -q get passwall2.$SHUNT.default_node)

# 1. TCP-пинг всех подходящих узлов (по 10 одновременно)
n=0
for id in $(uci show passwall2 | sed -n "s/^passwall2\.\([^.=]*\)\.group='\(.*\)'$/\1 \2/p" | while read -r nid g; do
             printf '%s\n' "$GROUPS" | grep -qxF "$(printf '%s' "$g" | tr 'A-Z' 'a-z')" && echo "$nid"; done); do
  if [ "$id" != "$CUR" ]; then
    [ "$(uci -q get passwall2.$id.protocol)" = "vless" ] || continue
    uci -q get passwall2.$id.remarks | grep -qE "$EXCLUDE" && continue
  fi
  addr=$(uci -q get passwall2.$id.address); port=$(uci -q get passwall2.$id.port)
  [ -n "$addr" ] && [ -n "$port" ] || continue
  ping_node "$id" "$addr" "$port" &
  n=$((n+1)); [ $((n % 10)) -eq 0 ] && wait
done
wait

# 2. Настоящая проверка: реальный запрос в интернет через текущий сервер.
#    Задержка — как пинг: два запроса по одному соединению, считаем второй (без подключения через VPN и рукопожатий).
#    Если второй не прошёл, а первый прошёл — VPN работает, задержку берём из первого (с подключением, она больше).
REAL=0; SOCKS_OK=1
for try in 1 2; do
  out=$(curl -s -o /dev/null -o /dev/null -w '%{http_code} %{time_starttransfer} %{time_pretransfer}\n' --max-time 8 -x "socks5h://$SOCKS" "$TEST_URL" "$TEST_URL"); rc=$?
  if [ $rc -eq 7 ]; then SOCKS_OK=0; break; fi
  ms=$(echo "$out" | awk '$1 == "204" { v = int(($2 - $3) * 1000 + 0.5); if (v < 1) v = 1; if (NR == 2) b = v; else f = int($2 * 1000) }
    END { print (b ? b : f + 0) }')
  [ "${ms:-0}" -gt 0 ] && { [ $REAL -eq 0 ] || [ $ms -lt $REAL ]; } && REAL=$ms
done

if [ $SOCKS_OK -eq 1 ]; then
  HEALTH=$REAL; REAL_JSON=$REAL; SOCKS_JSON=true
else
  HEALTH=$(cat $DIR/res/$CUR 2>/dev/null || echo 0); REAL_JSON=null; SOCKS_JSON=false
fi

echo "$(date +%s) $HEALTH" >> $DIR/history
tail -n $HIST_MAX $DIR/history > $DIR/history.tmp && mv $DIR/history.tmp $DIR/history

# 3. Результат для страницы
{
  printf '{"updated":%s,"current":"%s","socks":%s,"real":%s,"nodes":[' "$(date +%s)" "$CUR" "$SOCKS_JSON" "$REAL_JSON"
  first=1
  for f in $DIR/res/*; do
    [ -f "$f" ] || continue
    id=$(basename "$f"); ms=$(cat "$f")
    name=$(uci -q get passwall2.$id.remarks | sed 's/^ *//;s/ *$//;s/\\/\\\\/g;s/"/\\"/g')
    [ $first -eq 1 ] || printf ','
    first=0
    grp=$(uci -q get passwall2.$id.group | sed 's/\\/\\\\/g;s/"/\\"/g')
    [ "$grp" = fspirat ] && own=',"own":true' || own=''
    printf '{"id":"%s","name":"%s","ms":%s,"group":"%s"%s}' "$id" "$name" "$ms" "$grp" "$own"
  done
  printf ']}'
} > $DIR/ping.json.tmp && mv $DIR/ping.json.tmp $DIR/ping.json

# 4. Автопереключение
FAILS=$(cat $DIR/fails 2>/dev/null || echo 0)
if [ "$CUR" = _direct ]; then
  FAILS=0                           # выбран режим «Напрямую (без VPN)» — это решение пользователя, VPN сами не включаем
elif [ -z "$(uci -q get passwall2.$CUR.address)" ]; then
  FAILS=$FAILS_TO_SWITCH            # текущего узла больше нет (например, после обновления подписки)
elif [ "$HEALTH" -gt 0 ]; then
  FAILS=0
else
  FAILS=$((FAILS+1))
fi
echo $FAILS > $DIR/fails

if [ $FAILS -ge $FAILS_TO_SWITCH ]; then
  BEST=""; BEST_MS=999999
  for f in $DIR/res/*; do
    id=$(basename "$f"); ms=$(cat "$f")
    [ "$id" = "$CUR" ] && continue
    [ "$ms" -gt 0 ] || continue
    uci -q get passwall2.$id.remarks | grep -qE "$EXCLUDE" && continue
    [ "$ms" -lt "$BEST_MS" ] && { BEST=$id; BEST_MS=$ms; }
  done
  if [ -n "$BEST" ]; then
    uci set passwall2.$SHUNT.default_node=$BEST
    uci commit passwall2
    /etc/init.d/passwall2 restart >/dev/null 2>&1
    echo 0 > $DIR/fails
    logger -t fspirat "switch $CUR -> $BEST (${BEST_MS} ms)"
    echo "$(date '+%d.%m %H:%M') авто $CUR -> $BEST ${BEST_MS}ms" >> $DIR/switch.log
  fi
fi

# 4б. Подписка VPN (срок и трафик) — раз в час и если ещё нет данных
if [ ! -s $DIR/sub.json ] || [ $(( $(date +%M | sed 's/^0//') )) -lt 5 ]; then ( setsid /usr/bin/fspirat-sub </dev/null >/dev/null 2>&1 & ); fi

# 5. Задержка до сервисов (YouTube, Discord, серверы Minecraft) — для блока под текущим сервером
/usr/bin/fspirat-targets >/dev/null 2>&1
# 6. То же через все живые серверы (в фоне, раз в 30 минут; по кнопке «Пинг всех» — сразу)
if [ "$1" = all ] || [ $(( $(date +%M | sed 's/^0//') % 30 )) -lt 5 ]; then
  ( setsid /usr/bin/fspirat-svcping </dev/null >/dev/null 2>&1 & )
fi
