#!/usr/bin/lua
-- FSPIRAT: разбудить компьютер (Wake-on-LAN): «магический пакет» — 6 байт FF и 16 раз MAC.
-- fspirat-wake MAC [IP] — шлёт широковещательно в домашнюю сеть (порты 9 и 7) и, если есть IP, ещё напрямую на него.
-- По Wi-Fi работает только из сна (S3) и только если адаптер это умеет (Wake on Magic Packet в Windows).
local nixio = require 'nixio'
local mac, ip = arg[1] or '', arg[2]
if not mac:lower():match('^%x%x:%x%x:%x%x:%x%x:%x%x:%x%x$') then io.stderr:write('bad mac\n'); os.exit(2) end
local raw = mac:gsub(':', ''):gsub('%x%x', function(h) return string.char(tonumber(h, 16)) end)
local pkt = string.rep('\255', 6) .. string.rep(raw, 16)
local lan = io.popen('uci -q get network.lan.ipaddr'):read('*l') or '192.168.7.1/24'
local bcast = lan:match('^(%d+%.%d+%.%d+)%.') .. '.255'
local s = nixio.socket('inet', 'dgram')
s:setopt('socket', 'broadcast', 1)
local sent = 0
for _ = 1, 3 do
  for _, port in ipairs({9, 7}) do
    if s:sendto(pkt, bcast, port) then sent = sent + 1 end
    if ip and ip:match('^%d+%.%d+%.%d+%.%d+$') and s:sendto(pkt, ip, port) then sent = sent + 1 end
  end
  nixio.nanosleep(0, 200000000)
end
s:close()
print(sent)
