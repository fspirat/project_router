#!/bin/sh
# FSPIRAT: адреса TCPShield для проброса Minecraft (192.168.7.108:25565) — набор inet fw4 fspirat_mc_tcpshield.
# Скачивает https://tcpshield.com/v4 (напрямую, при неудаче — через VPN), проверяет и обновляет живой набор
# и строку elements в /etc/nftables.d/20-fspirat-mc.nft (чтобы список пережил перезагрузку).
# Любая ошибка — список не меняется (не открываем всем). Запуск: cron раз в сутки.
URL=https://tcpshield.com/v4
F=/etc/nftables.d/20-fspirat-mc.nft
SET=fspirat_mc_tcpshield
T=/tmp/fspirat-tcpshield.$$
trap 'rm -f $T $T.n' EXIT INT TERM
log() { logger -t fspirat-tcpshield "$*"; echo "$*"; }

[ -f $F ] || { log "нет $F — нечего обновлять"; exit 1; }
curl -fsS -m 20 "$URL" -o $T 2>/dev/null || curl -fsS -m 30 -x socks5h://127.0.0.1:1070 "$URL" -o $T 2>/dev/null \
  || { log "ошибка загрузки — список не изменён"; exit 1; }
tr -d '\r' < $T | awk 'NF{print $1}' | sort -u > $T.n
n=$(grep -c . $T.n)
bad=$(grep -cvE '^([0-9]{1,3}\.){3}[0-9]{1,3}(/([0-9]|[12][0-9]|3[0-2]))?$' $T.n)
[ "$bad" = 0 ] && [ "$n" -ge 1 ] && [ "$n" -le 256 ] || { log "неверный ответ ($n строк, непонятных $bad) — список не изменён"; exit 1; }
grep -qE '/([0-9]|1[0-5])$' $T.n && { log "в списке слишком широкая сеть — не применяю"; exit 1; }

EL=$(tr '\n' ',' < $T.n | sed 's/,$//; s/,/, /g')
cur=$(sed -n 's/.*elements = { \(.*\) }.*# fspirat-tcpshield.*/\1/p' $F)
[ "$EL" = "$cur" ] && { echo "без изменений: $EL"; exit 0; }
printf 'flush set inet fw4 %s\nadd element inet fw4 %s { %s }\n' $SET $SET "$EL" | nft -f - \
  || { log "nft не принял список — без изменений"; exit 1; }
sed -i "s|elements = { .* }\(.*# fspirat-tcpshield\)|elements = { $EL }\1|" $F
log "обновлено: $EL"
