#!/bin/sh
# FSPIRAT: данные подписок VPN из заголовков ответа подписки → /tmp/fspirat/sub/<id>.json (по каждой подписке PassWall2)
#   subscription-userinfo: upload=…; download=…; total=… (0 — без лимита); expire=… (unix-время)
#   profile-title: название у провайдера (бывает base64:…)
# /tmp/fspirat/sub.json — подписка, которая закончится раньше всех (её показывают главная карточка, бот и сторож сервера).
# Ссылка подписки (это доступ) никуда не печатается. HWID не отправляется: это просмотр цифр, а не подключение
# нового устройства. Запуск: из fspirat-ping раз в час и после обновления подписки из панели.
DIR=/tmp/fspirat; mkdir -p $DIR/sub
ids=$(uci show passwall2 2>/dev/null | sed -n 's/^passwall2\.\([^.=]*\)=subscribe_list$/\1/p')
for f in $DIR/sub/*.json; do [ -f "$f" ] || continue; echo "$ids" | grep -qxF "$(basename "$f" .json)" || rm -f "$f"; done
best=''; best_exp=0
for S in $ids; do
  URL=$(uci -q get passwall2.$S.url)
  [ -n "$URL" ] || continue
  H=''
  for via in "-x socks5h://127.0.0.1:1070" ""; do               # сначала через VPN, не вышло — напрямую
    H=$(curl -s -m 20 $via --proto =https -A clash -D - -o /dev/null "$URL" 2>/dev/null | tr -d '\r')
    echo "$H" | grep -qi '^subscription-userinfo:' && break
  done
  ui=$(echo "$H" | grep -i '^subscription-userinfo:' | head -1 | cut -d: -f2-)
  [ -n "$ui" ] || continue
  val() { v=$(echo "$ui" | tr ';' '\n' | sed -n "s/^ *$1 *= *\([0-9]*\).*/\1/p" | head -1); echo "${v:-0}"; }
  title=$(echo "$H" | grep -i '^profile-title:' | head -1 | cut -d: -f2- | sed 's/^ *//')
  case "$title" in base64:*) title=$(echo "${title#base64:}" | base64 -d 2>/dev/null) ;; esac
  title=$(printf '%s' "$title" | tr -d '"\\\000-\037')
  exp=$(val expire)
  printf '{"ts":%s,"up":%s,"down":%s,"total":%s,"expire":%s,"title":"%s"}\n' "$(date +%s)" "$(val upload)" "$(val download)" "$(val total)" "$exp" "$title" > $DIR/sub/$S.json.tmp \
    && mv $DIR/sub/$S.json.tmp $DIR/sub/$S.json
  [ "$exp" -gt 0 ] && { [ $best_exp -eq 0 ] || [ "$exp" -lt $best_exp ]; } && { best=$S; best_exp=$exp; }
  [ -n "$best" ] || best=$S
done
if [ -n "$best" ]; then cp $DIR/sub/$best.json $DIR/sub.json.tmp && mv $DIR/sub.json.tmp $DIR/sub.json; else rm -f $DIR/sub.json; fi
