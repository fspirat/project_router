#!/bin/bash
# FSPIRAT: следит за роутером через туннель и пишет в Telegram.
# Запускается cron'ом раз в минуту. Настройки — в /etc/fspirat-watch.conf

source /etc/fspirat-watch.conf     # TG_TOKEN=...  TG_CHAT=...
# Адреса этой установки (deploy.conf на сервере): PANEL_DOMAIN, LUCI_DOMAIN; по желанию —
#   MTG_DOMAIN (свой Telegram-прокси), EXTRA_SITES (другие сайты на сервере, через пробел),
#   VDS_HOSTS («Имя=адрес;Имя=адрес» — свои VPN-серверы для /vds, вход по ключу VDS_KEY), VDS_LOCAL_NAME
[ -f /etc/fspirat-router/deploy.conf ] && source /etc/fspirat-router/deploy.conf
PANEL_DOMAIN=${PANEL_DOMAIN:-localhost}; VDS_KEY=${VDS_KEY:-/root/.ssh/vds2_key}
S=/var/lib/fspirat
mkdir -p $S
COOKIE=$(grep -o 'fspirat_token=[A-Za-z0-9]*' /etc/nginx/snippets/fspirat-router.conf)

send() {
  curl -s -m 15 "https://api.telegram.org/bot$TG_TOKEN/sendMessage" \
    --data-urlencode "chat_id=$TG_CHAT" --data-urlencode "text=$1" >/dev/null
}
get()  { cat "$S/$1" 2>/dev/null; }
put()  { echo "$2" > "$S/$1"; }
# История и журнал для страницы (читает /router/data, server/auth/data.php). Переживают перезагрузку роутера.
#   history.tsv: "время отклик_ms узел"  (отклик 0 — VPN не прошёл, -1 — роутер не на связи)
#   events.tsv:  "время<TAB>вид<TAB>текст"
hist()  { echo "$1" >> "$S/history.tsv"; }
event() { printf '%s\t%s\t%s\n' "$1" "$2" "${3//$'\t'/ }" >> "$S/events.tsv"; }
NOW=$(date +%s)
if [ "$(date +%M)" = 00 ]; then              # раз в час: история за 35 дней, журнал — 2000 строк
  [ -f $S/history.tsv ] && awk -v t=$((NOW - 35*86400)) '$1 >= t' $S/history.tsv > $S/history.tmp && mv $S/history.tmp $S/history.tsv
  [ -f $S/events.tsv ] && tail -n 2000 $S/events.tsv > $S/events.tmp && mv $S/events.tmp $S/events.tsv
fi

# Входы в панель роутера (журнал страницы входа server/auth): сообщить о входе и о подборе пароля
AUTHLOG=/var/log/fspirat-router-auth.log
if [ -f "$AUTHLOG" ]; then
  size=$(stat -c %s "$AUTHLOG"); pos=$(get authpos || echo 0)
  [ "$size" -lt "${pos:-0}" ] && pos=0                      # журнал повернули (logrotate)
  if [ "$size" -gt "${pos:-0}" ]; then
    tail -c +$((pos + 1)) "$AUTHLOG" | while read -r d t what ipkv rest; do
      ip=${ipkv#ip=}
      case "$what" in
        OK)     send "🔑 Вход в панель роутера: $ip ($d $t)" ;;
        LOGOUT_ALL) send "🚪 Выход из панели на всех устройствах: $ip ($d $t)" ;;
        LOCKED) [ "$(get "lock_$ip")" = "$d" ] || { send "⚠️ Подбор пароля к панели роутера с $ip — вход с этого адреса закрыт на 15 минут."; put "lock_$ip" "$d"; } ;;
      esac
    done
    put authpos "$size"
  fi
fi

# Сайты, Telegram-прокси и сертификаты (раз в 5 минут): сообщение при сбое (2 проверки подряд) и при восстановлении
check() { # имя  ok(0/1)  текст_сбоя
  local n=$(( $(get "fail_$1" || echo 0) )); 
  if [ "$2" = 1 ]; then
    [ "$(get "down_$1")" = 1 ] && send "🟢 Снова работает: $1"
    put "fail_$1" 0; put "down_$1" 0
  else
    n=$((n + 1)); put "fail_$1" $n
    [ $n -eq 2 ] && [ "$(get "down_$1")" != 1 ] && { send "🔴 Не работает: $1 — $3"; put "down_$1" 1; }
  fi
}
# Серверы для команды /vds (раз в 5 минут): этот сервер и свои VPN-серверы из VDS_HOSTS (по ключу VDS_KEY)
if [ $(( 10#$(date +%M) % 5 )) -eq 0 ] || [ ! -s $S/vds.json ]; then
  local_stat=$(/usr/local/bin/fspirat-vdsstat 2>/dev/null)
  list=$(jq -nc --arg n "${VDS_LOCAL_NAME:-Сервер панели}" --argjson s "${local_stat:-null}" '[{name: $n, local: true, stat: $s}]' 2>/dev/null)
  IFS=';' read -ra hosts <<<"${VDS_HOSTS:-}"
  for e in "${hosts[@]}"; do
    n=${e%%=*}; h=${e#*=}; [ -n "$n" ] && [[ $h =~ ^[A-Za-z0-9.:-]+$ ]] || continue
    st=$(timeout 15 ssh -i "$VDS_KEY" -o BatchMode=yes -o ConnectTimeout=6 "root@$h" 'bash -s' < /usr/local/bin/fspirat-vdsstat 2>/dev/null)
    list=$(jq -c --arg n "$n" --argjson s "${st:-null}" '. + [{name: $n, stat: $s}]' <<<"$list" 2>/dev/null || echo "$list")
  done
  printf '{"ts":%s,"servers":%s}\n' "$NOW" "${list:-[]}" | jq -c . > $S/vds.json.tmp 2>/dev/null && mv $S/vds.json.tmp $S/vds.json
fi

# Ссылка Telegram-прокси ещё раз — по кнопке в боте (/tgproxy): секрет читает только root
if [ -f /var/lib/fspirat-router-auth/tglink_now ]; then
  rm -f /var/lib/fspirat-router-auth/tglink_now
  sec=$(grep -oP '^secret = "\K[^"]+' /etc/mtg.toml 2>/dev/null)
  [ -n "$sec" ] && [ -n "$MTG_DOMAIN" ] && send "📨 Ссылка на свой Telegram-прокси:
https://t.me/proxy?server=$MTG_DOMAIN&port=443&secret=$sec

Ссылка = доступ. Давай только тем, кому доверяешь."
fi

# Состояние Telegram-прокси для панели (раз в минуту): работает ли mtg и сколько сейчас подключений
if [ -f /etc/systemd/system/mtg.service ]; then
  systemctl is-active --quiet mtg && act=true || act=false
  conns=$(ss -Htn state established '( sport = :10444 )' 2>/dev/null | wc -l)
  since=$(systemctl show mtg -p ActiveEnterTimestamp --value 2>/dev/null)
  since=$( [ -n "$since" ] && date -d "$since" +%s 2>/dev/null || echo 0)
  printf '{"active":%s,"conns":%d,"since":%d,"ts":%d}\n' "$act" "${conns:-0}" "${since:-0}" "$NOW" > $S/mtg.json.tmp && mv $S/mtg.json.tmp $S/mtg.json
fi

if [ $(( 10#$(date +%M) % 5 )) -eq 0 ]; then
  for u in https://$PANEL_DOMAIN/ $(for x in $EXTRA_SITES; do echo "https://$x/"; done) https://$PANEL_DOMAIN/router/login; do
    c=$(curl -s -o /dev/null -m 15 -w '%{http_code}' "$u")
    [ "$c" = 200 ] && check "$u" 1 || check "$u" 0 "ответ $c"
  done
  if [ -f /etc/systemd/system/mtg.service ]; then
    systemctl is-active --quiet mtg && check "Telegram-прокси" 1 || check "Telegram-прокси" 0 "служба mtg остановлена"
  fi
  if [ "$(date +%H%M)" = 1000 ]; then        # сертификаты — раз в день
    for d in $PANEL_DOMAIN $EXTRA_SITES $LUCI_DOMAIN $([ -f /etc/systemd/system/mtg.service ] && echo "$MTG_DOMAIN"); do
      end=$(echo | timeout 10 openssl s_client -connect 127.0.0.1:443 -servername "$d" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
      [ -n "$end" ] || continue
      left=$(( ($(date -d "$end" +%s) - NOW) / 86400 ))
      [ "$left" -lt 14 ] && send "🔐 Сертификат $d истекает через $left дн. (certbot должен был продлить — проверь: certbot renew --dry-run)"
    done
  fi
fi

J=$(curl -s -m 20 -b "$COOKIE" "http://127.0.0.1:8081/cgi-bin/fspirat?action=status")

# Роутер не отвечает
if ! jq -e '.running != null' >/dev/null 2>&1 <<<"$J"; then
  n=$(( $(get offcount || echo 0) + 1 )); put offcount $n
  [ -n "$(get offline_since)" ] || put offline_since "$NOW"
  hist "$NOW -1 -"
  if [ "$n" -eq 3 ] && [ "$(get offline)" != 1 ]; then
    send "🔴 Роутер не на связи уже 3 минуты (нет туннеля или нет интернета дома)."
    event "$(get offline_since)" offline "Роутер пропал со связи"
    put offline 1
  fi
  exit 0
fi
put offcount 0
if [ "$(get offline)" = 1 ]; then
  send "🟢 Роутер снова на связи."
  event "$NOW" online "Роутер снова на связи (не было $(( (NOW - $(get offline_since || echo $NOW)) / 60 )) мин)"
  put offline 0
fi
rm -f $S/offline_since
put last_ok "$NOW"

# Новое устройство в сети (MAC, которого ещё не было в списке DHCP). Первый запуск — только запоминаем всех.
KNOWN=$S/known_macs
macs=$(jq -r '.devices[]?.mac // empty | ascii_downcase' <<<"$J")
if [ ! -f $KNOWN ]; then
  sort -u <<<"$macs" > $KNOWN
else
  for m in $macs; do
    grep -qxF "$m" $KNOWN && continue
    echo "$m" >> $KNOWN
    info=$(jq -r --arg m "$m" '[.devices[] | select((.mac | ascii_downcase) == $m)][0]
      | [(if (.name // "") == "" then "без имени" else .name end), .ip,
         ({"5g": "Wi-Fi 5 ГГц", "6g": "Wi-Fi 6 ГГц", "2g": "Wi-Fi 2,4 ГГц", "wired": "кабель"}[.band // ""] // "")]
      | map(select(. != "")) | join(" · ")' <<<"$J")
    send "📱 Новое устройство в сети: $info
MAC $m
Если оно чужое — выключи ему интернет на странице роутера: https://$PANEL_DOMAIN/router/#net"
    event "$NOW" newdev "Новое устройство: $info ($m)"
  done
fi

# Трафик устройств: роутер отдаёт байты с момента создания своей таблицы (fspirat-fw), сюда — прирост по дням.
#   traffic.json: {"last": {mac: [up, dn]}, "days": {"ГГГГ-ММ-ДД": {mac: [up, dn]}}} — 62 дня
if jq -e '[.devices[]? | select(.up != null)] | length > 0' >/dev/null 2>&1 <<<"$J"; then
  [ -s $S/traffic.json ] || echo '{"last":{},"days":{}}' > $S/traffic.json
  jq --argjson j "$J" --arg day "$(date +%F)" --arg cut "$(date -d '-62 days' +%F)" '
    reduce ($j.devices[] | select(.up != null) | {m: (.mac | ascii_downcase), c: [.up, .dn]}) as $d (.;
      (.last[$d.m] // [0, 0]) as $l
      | [range(2) | if $d.c[.] >= $l[.] then $d.c[.] - $l[.] else $d.c[.] end] as $inc   # счётчик сбросился — считаем с нуля
      | .last[$d.m] = $d.c
      | .days[$day][$d.m] = [range(2) as $i | ((.days[$day][$d.m] // [0, 0])[$i] + $inc[$i])])
    | .days |= with_entries(select(.key >= $cut))' $S/traffic.json > $S/traffic.tmp && mv $S/traffic.tmp $S/traffic.json
fi

# Задержка до сервисов через текущий сервер (роутер меряет раз в 5 минут): targets.tsv "время имя ms" — для графика
tts=$(jq -r '.targets.ts // 0' <<<"$J")
if [ "$tts" -gt "$(get targetslast || echo 0)" ] 2>/dev/null; then
  jq -r --arg t "$tts" '.targets.list[]? | "\($t)\t\(.name)\t\(.vpn)"' <<<"$J" >> $S/targets.tsv
  put targetslast "$tts"
fi
[ "$(date +%M)" = 00 ] && [ -f $S/targets.tsv ] && awk -F'\t' -v t=$((NOW - 35*86400)) '$1 >= t' $S/targets.tsv > $S/targets.tmp && mv $S/targets.tmp $S/targets.tsv

# Перезагрузка роутера: время работы стало меньше прежнего
up=$(jq -r '.sys.uptime // 0' <<<"$J")
[ -n "$(get uptime)" ] && [ "$up" -lt "$(get uptime)" ] && event "$((NOW - up))" reboot "Роутер перезагрузился"
put uptime "$up"

# История отклика: точки роутера (раз в 5 минут), которых у нас ещё нет
cur=$(jq -r .current <<<"$J")
last=$(get histlast || echo 0)
while read -r ts ms; do
  [ "${ts:-0}" -gt "${last:-0}" ] 2>/dev/null || continue
  hist "$ts $ms $cur"; last=$ts
done < <(jq -r '.history[]? | "\(.[0]) \(.[1])"' <<<"$J")
put histlast "$last"

# Журнал роутера (последние 8 строк switch.log): новые строки — в наш журнал, id узлов заменяем именами
[ -s $S/routerlog ] && first=0 || first=1     # первый запуск: время берём из строк, дальше — время, когда заметили
touch $S/routerlog
jq -r '.log[]?' <<<"$J" | while IFS= read -r line; do
  grep -qxF -- "$line" $S/routerlog && continue
  echo "$line" >> $S/routerlog
  # "06.10 17:30 авто ID -> ID 85ms"
  d=${line:0:5}; t=${line:6:5}; rest=${line:12}; ts=$NOW
  if [ $first = 1 ]; then
    ts=$(TZ=Europe/Samara date -d "$(date +%Y)-${d:3:2}-${d:0:2} $t" +%s 2>/dev/null || echo $NOW)   # время роутера — Самара
    [ "$ts" -gt "$NOW" ] && ts=$NOW
  fi
  for id in $(grep -oE '\b[A-Za-z0-9]{8}\b' <<<"$rest"); do
    nm=$(jq -r --arg c "$id" '[.ping.nodes[]? | select(.id==$c) | .name][0] // empty' <<<"$J")
    [ -n "$nm" ] && rest=${rest//$id/$nm}
  done
  rest=${rest//_direct/Напрямую (без VPN)}
  case "$rest" in
    авто*) kind=auto; rest="Автопереключение: ${rest#авто }" ;;
    вручную*) kind=manual; rest="Сервер выбран вручную: ${rest#вручную -> }" ;;
    перезапуск*) kind=restart; rest="Перезапуск VPN" ;;
    обновление*) kind=update; rest="Обновление подписки" ;;
    *) kind=router ;;
  esac
  event "$ts" "$kind" "$rest"
done
tail -n 50 $S/routerlog > $S/routerlog.tmp && mv $S/routerlog.tmp $S/routerlog

# VPN (Xray) остановлен / запущен
run=$(jq -r .running <<<"$J")
if [ "$run" != "$(get running)" ] && [ -n "$(get running)" ]; then
  if [ "$run" = true ]; then send "🟢 VPN снова работает."; event "$NOW" vpn_up "VPN снова работает"
  else send "⚠️ VPN на роутере остановлен (Xray не запущен)."; event "$NOW" vpn_down "VPN остановлен (Xray не запущен)"; fi
fi
put running "$run"

# Смена сервера
name=$(jq -r --arg c "$cur" '[.ping.nodes[]? | select(.id==$c) | .name][0] // $c' <<<"$J")
[ "$cur" = _direct ] && name="Напрямую (без VPN)"
prev=$(get current)
if [ -n "$prev" ] && [ "$cur" != "$prev" ]; then
  last=$(jq -r '.log[-1] // ""' <<<"$J")
  how="автоматически, текущий перестал отвечать"
  [[ $last == *вручную* ]] && how="вручную"
  send "🔁 VPN-сервер сменён ($how): $(get current_name) → $name"
fi
put current "$cur"; put current_name "$name"

# Флеш-память
pct=$(jq -r '.sys | if .disk_total > 0 then (.disk_used * 100 / .disk_total | floor) else 0 end' <<<"$J")
if [ "$pct" -ge 90 ] && [ "$(get flash)" != 1 ]; then
  send "💾 Флеш-память роутера заполнена на $pct%. Новые пакеты скоро перестанут ставиться."; put flash 1
elif [ "$pct" -lt 85 ]; then put flash 0; fi

# Тест скорости: каждый новый результат — в историю для графика (speed.tsv "время вид загрузка отдача задержка"), 180 дней
for via in vpn direct; do
  row=$(jq -r --arg v $via '.speed[$v] // empty | select(.ts) | "\(.ts) \($v) \(.down // 0) \(.up // 0) \(.latency // 0)"' <<<"$J")
  [ -n "$row" ] || continue
  ts=${row%% *}
  [ "$ts" -gt "$(get speedlast_$via || echo 0)" ] 2>/dev/null && { echo "$row" >> $S/speed.tsv; put speedlast_$via "$ts"; }
done
[ "$(date +%H%M)" = 0300 ] && [ -f $S/speed.tsv ] && awk -v t=$((NOW - 180*86400)) '$1 >= t' $S/speed.tsv > $S/speed.tmp && mv $S/speed.tmp $S/speed.tsv

# Подписка VPN (роутер берёт из заголовков подписки, которая кончится раньше всех): за 3 дня до конца — напоминание раз в день
exp=$(jq -r '.sub.expire // 0' <<<"$J")
if [ "${exp:-0}" -gt 0 ] 2>/dev/null; then
  left=$(( (exp - NOW) / 86400 ))
  if [ "$left" -le 3 ] && [ "$(get sub_warned)" != "$(date +%F)" ]; then
    send "⏳ Подписка VPN заканчивается через $left дн. — $(TZ=Europe/Samara date -d @$exp '+%d.%m.%Y'). Продли, иначе VPN дома перестанет работать."
    put sub_warned "$(date +%F)"
  fi
fi

# Отчёт за сутки — каждый день в 9:00 по Самаре (05:00 UTC на сервере)
RNOW=/var/lib/fspirat-router-auth/report_now      # команда /report в Telegram-боте
force=0; [ -f $RNOW ] && { rm -f $RNOW; force=1; }
if { [ "$(date -u +%H%M)" = 0500 ] && [ "$(get report_day)" != "$(date +%F)" ]; } || [ $force = 1 ]; then
  [ $force = 1 ] || put report_day "$(date +%F)"
  from=$((NOW - 86400))
  read -r okn avg fails offm <<<"$(awk -v t=$from '$1 >= t { if ($2 > 0) { n++; s += $2 } else if ($2 == 0) f++; else o++ } END { printf "%d %d %d %d", n, (n ? s / n : 0), f, o }' $S/history.tsv 2>/dev/null)"
  sw=$(awk -F'\t' -v t=$from '$1 >= t && ($2 == "auto" || $2 == "manual")' $S/events.tsv 2>/dev/null | wc -l)
  nd=$(awk -F'\t' -v t=$from '$1 >= t && $2 == "newdev"' $S/events.tsv 2>/dev/null | wc -l)
  yday=$(date -u -d yesterday +%F)
  NAMES=/var/lib/fspirat-router-auth/names.json
  top=$(jq -r --arg d "$yday" --argjson j "$J" --slurpfile n <(cat $NAMES 2>/dev/null || echo '{}') '
    (.days[$d] // {}) | to_entries | sort_by(-.value[1]) | .[:3][]
    | .key as $m | (($n[0][$m]) // ([$j.devices[]? | select((.mac | ascii_downcase) == $m) | .name][0]) // $m) as $nm
    | "  • \(if $nm == "" then $m else $nm end): ↓\(.value[1] / 1073741824 * 10 | floor / 10) ГБ"' $S/traffic.json 2>/dev/null)
  sub=$(jq -r 'if .sub.expire then "Подписка: до \(.sub.expire | strftime("%d.%m")), осталось \(((.sub.expire - now) / 86400) | floor) дн." else "" end' <<<"$J")
  msg="📊 Роутер за сутки
Сервер: $name, задержка $(jq -r '.ping.real // 0' <<<"$J") ms
Связь: средняя задержка ${avg:-0} ms, сбоев VPN ${fails:-0}, без связи ${offm:-0} мин
Работает без перезагрузки: $(( $(jq -r '.sys.uptime // 0' <<<"$J") / 86400 )) дн.
Смен сервера: $sw · новых устройств: $nd"
  [ -n "$top" ] && msg="$msg
Больше всех скачали вчера:
$top"
  [ -n "$sub" ] && msg="$msg
$sub"
  send "$msg"
fi
